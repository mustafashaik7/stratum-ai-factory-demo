{
  "schema_version": 1,
  "items": [
    {
      "id": "session",
      "scope_keys": [
        "tenant_id",
        "subject_id",
        "session_id"
      ],
      "retention_seconds": 3600,
      "authorization_source": false,
      "store": "unbound",
      "checkpoint_on": [
        "approval_wait",
        "before_write",
        "after_tool"
      ],
      "replay_policy": "revalidate_authorization_and_reconcile_writes"
    }
  ]
}
