{
  "schema_version": 1,
  "items": [
    {
      "id": "agent-run",
      "events": [
        "request.accepted",
        "policy.decided",
        "agent.started",
        "retrieval.completed",
        "model.completed",
        "tool.completed",
        "approval.waiting",
        "workflow.completed",
        "workflow.failed"
      ],
      "trace_fields": [
        "trace_id",
        "request_id",
        "workflow_id",
        "release_id"
      ],
      "metrics": [
        "ttft_ms",
        "output_tokens_per_second",
        "e2e_latency_ms",
        "queue_ms",
        "tool_error_rate",
        "task_completion_rate",
        "cost_per_completed_task"
      ],
      "raw_content_logging": false,
      "audit_sampling": false,
      "sink": "unbound"
    }
  ]
}
